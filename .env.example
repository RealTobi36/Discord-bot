# ── Discord Bot ──────────────────────────────────────────────
DISCORD_TOKEN=your-bot-token-here
CLIENT_ID=your-application-client-id-here

# Optional: Guild-ID zum sofortigen Registrieren von Slash-Commands (Development)
# Leer lassen, um Commands global zu registrieren (kann bis zu 1 Stunde dauern)
GUILD_ID=

# ── Optional ─────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
